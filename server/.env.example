NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/retech-market
CLIENT_URL=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_64chars
JWT_REFRESH_SECRET=change_me_refresh_secret_64chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Retech Market <no-reply@retechmarket.com>"

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Business rules
AUTO_CONFIRM_DAYS=5
SELLER_SHIP_DEADLINE_DAYS=3
PLATFORM_COMMISSION_PERCENT=0
